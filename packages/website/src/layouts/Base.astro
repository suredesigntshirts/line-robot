---
// Self-hosted brand fonts (@fontsource ships @font-face + woff2, lazy by unicode-range; served from
// /_astro/* — no external CDN). Weights match usage: body 400/700, headings 600/700.
import "@fontsource/sarabun/thai-400.css";
import "@fontsource/sarabun/thai-700.css";
import "@fontsource/sarabun/latin-400.css";
import "@fontsource/sarabun/latin-700.css";
import "@fontsource/noto-sans-thai/thai-600.css";
import "@fontsource/noto-sans-thai/thai-700.css";
import "@fontsource/noto-sans-thai/latin-600.css";
import "@fontsource/noto-sans-thai/latin-700.css";
// The website's Tailwind v4 entry: theme layer → Preflight → base rules → the shared @theme tokens
// (@line-robot/ui/theme.css, THE single token source) → the TECH-06 oklch/old-Android fallback.
import "../styles/global.css";
import { createTranslator } from "@line-robot/ui";
import ogDefault from "../assets/og-default.png";
import Footer from "../components/site/Footer.astro";
import Header from "../components/site/Header.astro";
import { safeJsonLdScript } from "../lib/jsonLd.ts";
import { localePath } from "../lib/site.ts";
import { isEmptySpec, serializeUiSpec, UI_VARIANTS } from "../lib/variants.ts";

interface Props {
  title: string;
  description: string;
  /** Canonical path for this page ("/properties/123"); joined onto the site origin. */
  canonicalPath: string;
  /** Absolute og:image URL (a presigned listing hero on detail pages). Omit → site default. */
  ogImage?: string;
  /** "website" (default) or "article". */
  ogType?: "website" | "article";
  /** Keep utility/error pages out of the index. */
  noindex?: boolean;
  /** Let a page own the <title> verbatim (default appends " · Brand"). */
  rawTitle?: boolean;
  /** Override the route-derived locale (the 404 page renders under a rewrite to "/404"). */
  locale?: "th" | "en";
}

const {
  title,
  description,
  canonicalPath,
  ogImage,
  ogType = "website",
  noindex = false,
  rawTitle = false,
  locale: localeOverride,
} = Astro.props;
const locale = localeOverride ?? (Astro.currentLocale === "en" ? "en" : "th");
const t = createTranslator(locale);
const site = Astro.site;
if (!site) throw new Error("Astro.site missing — set `site` in astro.config.mjs");
const canonical = new URL(canonicalPath, site);
// hreflang pair: default locale lives at "/", English under "/en/". x-default = Thai (DF-3).
const thPath = canonicalPath.replace(/^\/en(\/|$)/, "/");
const thUrl = new URL(thPath, site);
const enUrl = new URL(canonicalPath.startsWith("/en/") ? canonicalPath : `/en${canonicalPath}`, site);
const usingDefaultOg = !ogImage;
const ogImageUrl = ogImage ?? new URL(ogDefault.src, site).href;
const siteName = t("site.name");
// UI template variant (lib/variants.ts): stamped on <html> for analytics/tests; the switcher chip
// shows only on an explicit `?ui=` preview request, never for a cookie-assigned visitor.
const uiSpec = Astro.locals.ui ?? { pages: {} };
const uiSerialized = serializeUiSpec(uiSpec);
const showUiChip = Astro.locals.uiFromQuery === true && !isEmptySpec(uiSpec);
const uiHref = (value: string) => {
  const params = new URLSearchParams(Astro.url.search);
  params.set("ui", value);
  return `${Astro.url.pathname}?${params.toString()}`;
};
const documentTitle = rawTitle ? title : `${title} · ${siteName}`;

// Site-wide structured data: the organisation + a WebSite with its search action (site-links search).
const orgJsonLd = safeJsonLdScript({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${site.origin}/#organization`,
      name: siteName,
      url: site.origin,
      logo: new URL(ogDefault.src, site).href,
    },
    {
      "@type": "WebSite",
      "@id": `${site.origin}/#website`,
      url: site.origin,
      name: siteName,
      inLanguage: locale,
      publisher: { "@id": `${site.origin}/#organization` },
      potentialAction: {
        "@type": "SearchAction",
        target: {
          "@type": "EntryPoint",
          urlTemplate: `${site.origin}${localePath(locale, "/properties")}?q={search_term_string}`,
        },
        "query-input": "required name=search_term_string",
      },
    },
  ],
});
---

<!doctype html>
<html lang={locale} data-ui={uiSerialized || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="th" href={thUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={thUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1a1e26" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={locale === "en" ? "en_US" : "th_TH"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={ogImageUrl} />
    {usingDefaultOg && <meta property="og:image:width" content="1200" />}
    {usingDefaultOg && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    {/* Theme bootstrap — runs before first paint so an explicit choice never flashes the other mode.
        No stored choice → no attribute → theme.css follows the OS via prefers-color-scheme. */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
        } catch (e) {}
      })();
    </script>
    <script is:inline type="application/ld+json" set:html={orgJsonLd} />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col bg-bg font-body-th text-text leading-relaxed antialiased">
    <a href="#main" class="skip-link">{t("nav.skipToContent")}</a>
    <Header locale={locale} />
    <div class="flex-1">
      <slot />
    </div>
    <Footer locale={locale} />
    {
      showUiChip && (
        <div
          data-ui-chip
          class="fixed bottom-3 left-3 z-50 flex max-w-[calc(100vw-1.5rem)] flex-wrap items-center gap-2 rounded-full border border-border bg-surface/95 px-3 py-1.5 font-latin text-xs shadow-md backdrop-blur"
        >
          <span class="font-semibold text-text">{t("ui.variant")}: {uiSerialized}</span>
          {Object.entries(UI_VARIANTS).map(([page, variants]) => (
            <span class="flex items-center gap-1">
              <span class="text-text-disabled">{page}</span>
              {Object.entries(variants).map(([v, label]) => (
                <a
                  href={uiHref(`${page}:${v}`)}
                  title={label}
                  aria-current={(uiSpec.pages[page] ?? uiSpec.global) === v ? "true" : undefined}
                  class="rounded-full border border-border px-2 py-0.5 text-text-2 no-underline hover:text-text aria-[current=true]:border-primary-500 aria-[current=true]:bg-primary-500 aria-[current=true]:text-surface"
                >
                  {v}
                </a>
              ))}
            </span>
          ))}
          <a href={uiHref("reset")} class="text-primary-600 no-underline hover:underline">
            {t("ui.reset")}
          </a>
        </div>
      )
    }
  </body>
</html>
