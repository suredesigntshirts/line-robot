---
import { createTranslator, type UiLocale } from "@line-robot/ui";
import { type CollectionEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";
import { lineOaUrl, localePath } from "../lib/site.ts";
import Icon from "./site/Icon.astro";

/** Long-form page renderer for the markdown content collection (about / how-it-works / privacy / terms). */
interface Props {
  locale: UiLocale;
  slug: string;
  entry: CollectionEntry<"pages">;
}
const { locale, slug, entry } = Astro.props;
const t = createTranslator(locale);
const { Content } = await render(entry);
const oa = lineOaUrl();
const updated = entry.data.updated
  ? new Intl.DateTimeFormat(locale === "th" ? "th-TH" : "en-GB", {
      day: "numeric",
      month: "long",
      year: "numeric",
    }).format(new Date(entry.data.updated))
  : null;
---

<Base
  title={entry.data.title}
  description={entry.data.description}
  canonicalPath={localePath(locale, `/${slug}`)}
  ogType="article"
>
  <main id="main" data-th-content class="container-site grid gap-8 py-8 md:py-12">
    <nav aria-label="Breadcrumb" class="flex items-center gap-1 text-sm text-text-2 leading-relaxed">
      <a href={localePath(locale, "/")} class="no-underline hover:text-primary-600">{t("nav.home")}</a>
      <Icon name="chevron-right" size={14} class="text-text-disabled" />
      <span class="text-text">{entry.data.title}</span>
    </nav>

    <header class="grid max-w-3xl gap-3">
      <h1 class="font-bold font-heading-th text-3xl text-text leading-tight md:text-4xl" lang={locale}>
        {entry.data.title}
      </h1>
      <p class="text-lg text-text-2 leading-relaxed" lang={locale}>{entry.data.description}</p>
      {
        updated && (
          <p class="text-sm text-text-disabled leading-relaxed">{t("detail.updatedOn", { date: updated })}</p>
        )
      }
    </header>

    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_320px]">
      <article class="prose-site" lang={locale}>
        <Content />
      </article>

      <aside class="grid content-start gap-4 lg:sticky lg:top-24 lg:self-start">
        {
          oa !== "" && (
            <div class="grid gap-3 rounded-xl border border-border bg-surface p-5 shadow-sm">
              <div class="flex items-center gap-2 font-heading-th font-semibold text-base text-text leading-normal">
                <Icon name="message-circle" size={18} class="text-line" />
                {t("footer.lineHead")}
              </div>
              <p class="text-sm text-text-2 leading-relaxed">{t("footer.lineBody")}</p>
              <a
                href={oa}
                data-cta="line"
                class="inline-flex h-11 items-center justify-center gap-2 rounded-lg bg-line px-4 font-semibold text-base text-line-text no-underline leading-relaxed transition-opacity hover:opacity-90"
              >
                {t("cta.chatLine")}
              </a>
            </div>
          )
        }
        <nav class="grid gap-1 rounded-xl border border-border bg-surface p-3" aria-label={t("site.name")}>
          {
            [
              { slug: "how-it-works", label: t("nav.howItWorks") },
              { slug: "about", label: t("nav.about") },
              { slug: "contact", label: t("nav.contact") },
              { slug: "privacy", label: t("nav.privacy") },
              { slug: "terms", label: t("nav.terms") },
            ].map((l) => (
              <a
                href={localePath(locale, `/${l.slug}`)}
                aria-current={l.slug === slug ? "page" : undefined}
                class="flex items-center justify-between rounded-lg px-3 py-2 text-sm text-text-2 no-underline leading-relaxed transition-colors hover:bg-surface-2 hover:text-text aria-[current=page]:bg-primary-50 aria-[current=page]:font-semibold aria-[current=page]:text-primary-700"
              >
                {l.label}
                <Icon name="chevron-right" size={14} class="text-text-disabled" />
              </a>
            ))
          }
        </nav>
      </aside>
    </div>
  </main>
</Base>
