---
import {
  getDb,
  type PublicCardRow,
  type PublicListingDetail,
  searchPublicListings,
} from "@line-robot/db";
import { NO_SALE_DEED_TYPES } from "@line-robot/domain";
import {
  AccordionSection,
  Badge,
  createTranslator,
  FieldList,
  PriceDisplay,
  StatusBadge,
  type UiLocale,
} from "@line-robot/ui";
import Base from "../layouts/Base.astro";
import { type CardRow, withHeroUrls } from "../lib/cards.ts";
import { listingJsonLd, safeJsonLdScript } from "../lib/jsonLd.ts";
import { presignThumbs } from "../lib/media.ts";
import { lineOaUrl, localePath } from "../lib/site.ts";
import Gallery from "./detail/Gallery.astro";
import ListingGrid from "./ListingGrid.astro";
import { ResultsMap } from "./ResultsMap.tsx";
import Icon, { type IconName } from "./site/Icon.astro";

/**
 * Listing detail. Photo-first (CONV-04): gallery → title + badges → key facts → the asking price and
 * LINE CTA in a sticky side panel (desktop) / a sticky bottom bar (phones) → spec table, lease/condo
 * groups, description, provenance disclosure, map, poster + legal → similar listings. SEO: JSON-LD
 * RealEstateListing + BreadcrumbList, OG image = the hero. Pure renderer — the route owns loading.
 */
interface Props {
  locale: UiLocale;
  detail: PublicListingDetail;
}
const { locale, detail } = Astro.props;
const t = createTranslator(locale);
const { listing } = detail;
const canonicalPath = localePath(locale, `/properties/${listing.id}`);
const browseHref = localePath(locale, "/properties");
const oa = lineOaUrl();

// 4.1 gallery: presign the hero-ordered photo thumbs; drop any that fail to sign (degrade, never 500).
const galleryUrls = (await presignThumbs(detail.photos.map((p) => p.thumbKey))).filter(
  (u): u is string => u !== null,
);
const heroUrl = galleryUrls[0];

// Similar listings: same type in the same province (fallback: same province), newest first, minus self.
let similar: CardRow[] = [];
try {
  const pick = async (propertyType: boolean) =>
    (
      await searchPublicListings(getDb(), {
        lang: locale,
        ...(propertyType ? { propertyType: listing.propertyType } : {}),
        ...(listing.province ? { province: listing.province } : {}),
        pageSize: 5,
      })
    ).rows.filter((r: PublicCardRow) => r.listing.id !== listing.id);
  let rows = await pick(true);
  if (rows.length < 2) rows = await pick(false);
  similar = await withHeroUrls(rows.slice(0, 4));
} catch (error) {
  console.error("similar listings query failed:", error);
}

// TH-03 ruling: land units stay Thai on both locales — they are the market's units.
const landParts: string[] = [];
if (listing.landRai) landParts.push(`${listing.landRai} ไร่`);
if (listing.landNgan) landParts.push(`${listing.landNgan} งาน`);
if (listing.landWah) landParts.push(`${listing.landWah} ตร.ว.`);
const landLabel = landParts.length > 0 ? landParts.join(" ") : listing.landSqm !== null ? `${listing.landSqm} ตร.ม.` : null;

// Key-facts strip (CONV-04 above the fold): only the facts this listing has.
const facts: Array<{ icon: IconName; label: string; value: string }> = [];
if (listing.bedrooms !== null) facts.push({ icon: "bed", label: t("field.bedrooms"), value: String(listing.bedrooms) });
if (listing.bathrooms !== null) facts.push({ icon: "bath", label: t("field.bathrooms"), value: String(listing.bathrooms) });
if (listing.floorAreaSqm !== null) facts.push({ icon: "ruler", label: t("listing.floorArea"), value: `${listing.floorAreaSqm} ตร.ม.` });
if (landLabel) facts.push({ icon: "land-plot", label: t("listing.landArea"), value: landLabel });
facts.push({ icon: "house", label: t("filter.propertyType"), value: t(`ptype.${listing.propertyType}`) });

// COPY-04: restricted-transfer deed types carry their warning right in the deed row.
const deedRestricted = NO_SALE_DEED_TYPES.has(listing.titleDeedType);
const deedValue = deedRestricted
  ? `${t(`deed.${listing.titleDeedType}`)} — ${t("deed.restricted")}`
  : t(`deed.${listing.titleDeedType}`);

const roadParts: string[] = [];
if (listing.roadType !== null) roadParts.push(t(`road.${listing.roadType}`));
if (listing.roadAccessM !== null) roadParts.push(t("field.roadWidth", { m: listing.roadAccessM }));

const fieldRows = [
  { label: t("filter.propertyType"), value: t(`ptype.${listing.propertyType}`) },
  ...(listing.saleCondition !== "unknown"
    ? [{ label: t("filter.newVsResale"), value: t(`condition.${listing.saleCondition}`) }]
    : []),
  { label: t("listing.deedSection"), value: deedValue },
  ...(landLabel ? [{ label: t("listing.landArea"), value: landLabel }] : []),
  ...(listing.floorAreaSqm !== null ? [{ label: t("listing.floorArea"), value: `${listing.floorAreaSqm} ตร.ม.` }] : []),
  ...(listing.floodHistory !== null
    ? [{ label: t("field.flood"), value: t(listing.floodHistory ? "field.floodYes" : "field.floodNo") }]
    : []),
  ...(listing.tenure !== null
    ? [
        {
          label: t("field.tenure"),
          value: listing.leaseYears !== null ? `${listing.tenure} (${t("field.leaseYears", { count: listing.leaseYears })})` : listing.tenure,
        },
      ]
    : []),
  ...(listing.projectName !== null ? [{ label: t("field.project"), value: listing.projectName }] : []),
  ...(listing.facingDirection !== null ? [{ label: t("field.facing"), value: t(`facing.${listing.facingDirection}`) }] : []),
  ...(roadParts.length > 0 ? [{ label: t("field.road"), value: roadParts.join(" · ") }] : []),
  ...(listing.cityPlanZoneColor !== null && listing.cityPlanZoneColor !== ""
    ? [{ label: t("field.zone"), value: listing.cityPlanZoneColor }]
    : []),
];

// Condo group (FIELD-04/05), omit-when-absent.
const condo = detail.condo;
const foreignQuotaParts: string[] = [];
if (condo?.projectForeignQuotaPct != null) foreignQuotaParts.push(t("field.foreignQuotaPct", { pct: condo.projectForeignQuotaPct }));
if (condo?.foreignQuotaAvailable != null)
  foreignQuotaParts.push(t(condo.foreignQuotaAvailable ? "field.foreignQuotaAvailable" : "field.foreignQuotaFull"));
const condoRows = condo
  ? [
      ...(condo.camFeePerSqmMonth !== null ? [{ label: t("field.camFee"), value: t("field.camFeeValue", { thb: condo.camFeePerSqmMonth }) }] : []),
      ...(condo.sinkingFundPerSqm !== null ? [{ label: t("field.sinkingFund"), value: t("field.sinkingFundValue", { thb: condo.sinkingFundPerSqm }) }] : []),
      ...(foreignQuotaParts.length > 0 ? [{ label: t("field.foreignQuota"), value: foreignQuotaParts.join(" · ") }] : []),
      ...(condo.quotaBucket !== null ? [{ label: t("field.quotaBucket"), value: t(`quota.${condo.quotaBucket}`) }] : []),
    ]
  : [];

// Rental lease terms (DEAL-11/FIELD-08/12), rentals only.
const rental = listing.dealType === "rent" ? detail.rental : null;
const furnishingParts: string[] = [];
if (rental?.furnishingStatus != null) furnishingParts.push(t(`furnishing.${rental.furnishingStatus}`));
if (rental?.furnishingNotes != null && rental.furnishingNotes !== "") furnishingParts.push(rental.furnishingNotes);
const rentalRows = rental
  ? [
      ...(rental.depositMonths !== null ? [{ label: t("field.deposit"), value: t("field.monthsValue", { count: rental.depositMonths }) }] : []),
      ...(rental.advanceMonths !== null ? [{ label: t("field.advance"), value: t("field.monthsValue", { count: rental.advanceMonths }) }] : []),
      ...(rental.minLeaseMonths !== null ? [{ label: t("field.minLease"), value: t("field.monthsValue", { count: rental.minLeaseMonths }) }] : []),
      ...(furnishingParts.length > 0 ? [{ label: t("field.furnishing"), value: furnishingParts.join(" — ") }] : []),
      ...(rental.petsAllowed !== null ? [{ label: t("field.pets"), value: t(rental.petsAllowed ? "field.petsYes" : "field.petsNo") }] : []),
      ...(rental.utilityRateType !== null && rental.utilityRateType !== "unknown"
        ? [{ label: t("field.utilities"), value: t(`utility.${rental.utilityRateType}`) }]
        : []),
    ]
  : [];

// DIST-01/02/P8 provenance disclosure — calm, but the DIST-02 caveats stay visible for auctions.
const provenanceNote =
  listing.listingType === "npa" ? t("provenance.npa") : listing.listingType === "auction" ? t("provenance.auction") : null;
const auctionCaveats =
  listing.listingType === "auction"
    ? [t("provenance.auctionAsIs"), t("provenance.auctionOccupied"), t("provenance.auctionVerifyTitle")]
    : [];

const locationLine = [listing.landmark, listing.tambon, listing.amphoe, listing.province]
  .filter((p): p is string => p !== null && p !== "")
  .join(" · ");
const updatedLabel = new Intl.DateTimeFormat(locale === "th" ? "th-TH" : "en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "Asia/Bangkok",
}).format(listing.updatedAt);
const hasMap = detail.lat !== null && detail.lon !== null;
const pins = hasMap
  ? [{ id: listing.id, lat: detail.lat as number, lng: detail.lon as number, title: detail.headline, href: canonicalPath }]
  : [];

const pageUrl = new URL(canonicalPath, Astro.site).href;
const jsonLd = safeJsonLdScript({
  "@context": "https://schema.org",
  "@graph": [
    listingJsonLd(detail, pageUrl, galleryUrls),
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: t("nav.home"), item: new URL(localePath(locale, "/"), Astro.site).href },
        { "@type": "ListItem", position: 2, name: t("nav.browse"), item: new URL(browseHref, Astro.site).href },
        { "@type": "ListItem", position: 3, name: detail.headline, item: pageUrl },
      ],
    },
  ],
});

const ctaClass =
  "inline-flex h-12 w-full items-center justify-center gap-2 rounded-xl bg-line px-5 font-semibold text-base text-line-text no-underline leading-relaxed shadow-sm transition-opacity hover:opacity-90";
const ghostClass =
  "inline-flex h-10 flex-1 items-center justify-center gap-1.5 rounded-lg border border-border bg-surface px-3 font-medium text-sm text-text leading-relaxed transition-colors hover:border-primary-300 hover:text-primary-600";
---

<Base title={detail.headline} description={locationLine || detail.description.slice(0, 160)} canonicalPath={canonicalPath} ogImage={heroUrl} ogType="article">
  <script is:inline type="application/ld+json" set:html={jsonLd} slot="head" />
  <main id="main" data-th-content class="container-site grid gap-6 pt-5 pb-28 md:gap-8 md:py-8" data-listing-id={listing.id}>
    <nav aria-label="Breadcrumb" class="flex min-w-0 items-center gap-1 text-sm text-text-2 leading-relaxed">
      <a href={localePath(locale, "/")} class="shrink-0 no-underline hover:text-primary-600">{t("nav.home")}</a>
      <Icon name="chevron-right" size={14} class="shrink-0 text-text-disabled" />
      <a href={browseHref} class="shrink-0 no-underline hover:text-primary-600">{t("nav.browse")}</a>
      <Icon name="chevron-right" size={14} class="shrink-0 text-text-disabled" />
      <span class="truncate text-text" lang={locale}>{detail.headline}</span>
    </nav>

    {
      galleryUrls.length > 0 ? (
        <Gallery urls={galleryUrls} photoCount={detail.photoCount} alt={detail.headline} locale={locale} />
      ) : (
        <div class="grid aspect-[16/7] place-items-center rounded-xl border border-border bg-gradient-to-br from-primary-50 to-primary-100 text-primary-400">
          <div class="grid justify-items-center gap-2">
            <Icon name="camera" size={40} strokeWidth={1.5} />
            <span class="text-sm leading-relaxed">
              {detail.photoCount > 0 ? t("listing.photos", { count: detail.photoCount }) : t("detail.noPhotos")}
            </span>
          </div>
        </div>
      )
    }

    <div class="grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_360px]">
      {/* ---------- main column ---------- */}
      <article class="grid gap-6">
        <header class="grid gap-3">
          <StatusBadge listing={listing} t={t} />
          <h1 class="font-bold font-heading-th text-2xl text-text leading-tight md:text-3xl" lang={locale}>{detail.headline}</h1>
          {locationLine && (
            <p lang="th" class="flex items-start gap-1.5 text-base text-text-2 leading-relaxed">
              <Icon name="map-pin" size={18} class="mt-1 shrink-0 text-primary-500" />
              <span>{locationLine}</span>
            </p>
          )}
        </header>

        {/* Price block — visible here on phones/tablets; the desktop aside carries it instead. */}
        <div class="rounded-xl border border-primary-100 bg-primary-50 px-4 py-3 lg:hidden">
          <PriceDisplay listing={listing} monthlyRent={detail.monthlyRent} size="detail" t={t} />
        </div>

        <ul class="grid grid-cols-2 gap-2 sm:grid-cols-3 md:grid-cols-5" aria-label={t("detail.keyFacts")}>
          {facts.map((f) => (
            <li class="flex items-center gap-3 rounded-lg border border-border bg-surface px-3 py-2.5">
              <Icon name={f.icon} size={20} class="shrink-0 text-primary-500" />
              <span class="grid min-w-0">
                <span class="truncate text-text-2 text-xs leading-relaxed">{f.label}</span>
                <span class="truncate font-semibold text-sm text-text leading-relaxed">{f.value}</span>
              </span>
            </li>
          ))}
        </ul>

        {deedRestricted && (
          <p class="flex items-start gap-2 rounded-lg border border-warn/40 bg-warn-bg px-4 py-3 text-sm text-text leading-relaxed">
            <Icon name="triangle-alert" size={18} class="mt-0.5 shrink-0 text-warn" />
            <span>{t("deed.restricted")}</span>
          </p>
        )}

        {provenanceNote !== null && (
          <section aria-label={t("provenance.heading")} class="grid gap-2 rounded-xl border border-border bg-surface-2 p-4">
            <strong class="flex items-center gap-2 text-sm text-text leading-relaxed" lang={locale}>
              <Icon name="info" size={16} class="text-[var(--badge-npa-text)]" />
              {t("provenance.heading")}
            </strong>
            <p class="text-sm text-text-2 leading-relaxed" lang={locale}>{provenanceNote}</p>
            {auctionCaveats.length > 0 && (
              <ul class="grid list-disc gap-1 ps-5 text-sm text-text-2 leading-relaxed">
                {auctionCaveats.map((c) => <li lang={locale}>{c}</li>)}
              </ul>
            )}
          </section>
        )}

        {detail.description !== "" && (
          <section class="grid gap-3">
            <h2 class="font-heading-th font-semibold text-lg text-text leading-normal">{t("detail.description")}</h2>
            <p lang={locale} class="whitespace-pre-wrap text-base text-text-2 leading-relaxed">{detail.description}</p>
          </section>
        )}

        <section class="grid gap-3">
          <h2 class="font-heading-th font-semibold text-lg text-text leading-normal">{t("detail.specSection")}</h2>
          <FieldList rows={fieldRows} />
        </section>

        {rentalRows.length > 0 && (
          <AccordionSection title={t("detail.rentalSection")} defaultOpen>
            <FieldList rows={rentalRows} />
          </AccordionSection>
        )}
        {condoRows.length > 0 && (
          <AccordionSection title={t("detail.condoSection")} defaultOpen>
            <FieldList rows={condoRows} />
          </AccordionSection>
        )}

        {hasMap && (
          <section class="grid gap-2">
            <h2 class="font-heading-th font-semibold text-lg text-text leading-normal">{t("detail.location")}</h2>
            <ResultsMap client:visible pins={pins} locale={locale} showTitle={false} />
            <p class="text-sm text-text-disabled leading-relaxed">{t("detail.mapApprox")}</p>
          </section>
        )}

        <footer class="grid gap-2 border-border border-t pt-4 text-sm text-text-2 leading-relaxed">
          <p class="flex flex-wrap gap-x-3 gap-y-1">
            {detail.posterName !== "" && <span>{t("listing.postedBy", { name: detail.posterName })}</span>}
            <span data-testid="listing-updated">{t("listing.updated", { date: updatedLabel })}</span>
            <span class="font-latin text-text-disabled">{t("detail.listingId")}: {listing.id.slice(0, 8)}</span>
          </p>
          <p>{t("legal.posterProvided")}</p>
          {/* LEGAL-07: non-dismissible foreign-ownership disclaimer. */}
          <p>{t("legal.foreignOwnership")}</p>
        </footer>
      </article>

      {/* ---------- sticky side panel (desktop) ---------- */}
      <aside class="hidden lg:sticky lg:top-24 lg:grid lg:gap-4 lg:self-start" aria-label={t("detail.contactHead")}>
        <div class="grid gap-4 rounded-2xl border border-border bg-surface p-5 shadow-md">
          <div class="rounded-xl border border-primary-100 bg-primary-50 px-4 py-3">
            <PriceDisplay listing={listing} monthlyRent={detail.monthlyRent} size="detail" t={t} />
          </div>
          <div class="grid gap-1">
            <h2 class="font-heading-th font-semibold text-md text-text leading-normal">{t("detail.contactHead")}</h2>
            <p class="text-sm text-text-2 leading-relaxed">{t("detail.contactBody")}</p>
          </div>
          {oa !== "" && (
            <a href={oa} data-cta="line" class={ctaClass}>
              <Icon name="message-circle" size={20} />
              {t("cta.chatLine")}
            </a>
          )}
          <div class="flex gap-2" data-share>
            <button type="button" data-share-native class={`${ghostClass} hidden`}>
              <Icon name="share-2" size={16} />
              {t("detail.share")}
            </button>
            <button type="button" data-copy-link data-copied-label={t("detail.copied")} data-label={t("detail.copyLink")} class={ghostClass}>
              <Icon name="link" size={16} />
              <span>{t("detail.copyLink")}</span>
            </button>
          </div>
          {detail.posterName !== "" && (
            <div class="flex items-center gap-3 border-border border-t pt-4">
              <span class="flex size-10 items-center justify-center rounded-full bg-primary-50 text-primary-600">
                <Icon name="user" size={18} />
              </span>
              <span class="grid min-w-0">
                <span class="text-text-2 text-xs leading-relaxed">{t("detail.postedHead")}</span>
                <span class="truncate font-semibold text-sm text-text leading-relaxed">{detail.posterName}</span>
              </span>
            </div>
          )}
        </div>
        <p class="px-1 text-text-disabled text-xs leading-relaxed">{t("legal.posterProvided")}</p>
      </aside>
    </div>

    {similar.length > 0 && (
      <section class="grid gap-5 border-border border-t pt-8" aria-labelledby="similar-heading">
        <div class="flex items-end justify-between gap-4">
          <h2 id="similar-heading" class="font-bold font-heading-th text-2xl text-text leading-tight">{t("detail.similar")}</h2>
          <a href={browseHref} class="inline-flex items-center gap-1 font-semibold text-primary-600 text-sm no-underline leading-relaxed hover:underline">
            {t("home.viewAll")}
            <Icon name="arrow-right" size={16} />
          </a>
        </div>
        <ListingGrid rows={similar} locale={locale} columns="home" />
      </section>
    )}
  </main>

  {/* ---------- sticky bottom bar (phones/tablets) ---------- */}
  <div class="fixed inset-x-0 bottom-0 z-30 border-border border-t bg-surface/95 pb-[env(safe-area-inset-bottom)] backdrop-blur lg:hidden" data-sticky-cta>
    <div class="container-site flex items-center gap-3 py-3">
      <div class="min-w-0 flex-1">
        <PriceDisplay listing={listing} monthlyRent={detail.monthlyRent} size="card" t={t} />
      </div>
      {oa !== "" && (
        <a href={oa} data-cta="line" class="inline-flex h-12 shrink-0 items-center justify-center gap-2 rounded-xl bg-line px-5 font-semibold text-base text-line-text no-underline leading-relaxed shadow-sm">
          <Icon name="message-circle" size={20} />
          {t("cta.chatLine")}
        </a>
      )}
    </div>
  </div>
</Base>

<script>
  // Share: native share sheet where available (phones), copy-link everywhere.
  const shareBtn = document.querySelector<HTMLButtonElement>("[data-share-native]");
  if (shareBtn && typeof navigator.share === "function") {
    shareBtn.classList.remove("hidden");
    shareBtn.addEventListener("click", () => {
      navigator.share({ title: document.title, url: location.href }).catch(() => {});
    });
  }
  const copyBtn = document.querySelector<HTMLButtonElement>("[data-copy-link]");
  if (copyBtn) {
    const label = copyBtn.querySelector("span");
    copyBtn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(location.href);
        if (label) label.textContent = copyBtn.dataset.copiedLabel ?? "";
        setTimeout(() => {
          if (label) label.textContent = copyBtn.dataset.label ?? "";
        }, 2000);
      } catch {
        /* clipboard blocked — nothing to do; the URL bar still works */
      }
    });
  }
</script>
