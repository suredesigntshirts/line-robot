---
import type { PublicListingDetail } from "@line-robot/db";
import { NO_SALE_DEED_TYPES } from "@line-robot/domain";
import {
  AccordionSection,
  Badge,
  createTranslator,
  FieldList,
  LineCtaButton,
  PriceDisplay,
  StatusBadge,
  type UiLocale,
} from "@line-robot/ui";
import Base from "../layouts/Base.astro";
import { listingJsonLd, safeJsonLdScript } from "../lib/jsonLd.ts";
import { presignThumbs } from "../lib/media.ts";

// S4-I3: listing detail with the SEO deliverables (JSON-LD RealEstateListing,
// OG, canonical, hreflang). Pure renderer — the routes own loading + status codes.
interface Props {
  locale: UiLocale;
  detail: PublicListingDetail;
}
const { locale, detail } = Astro.props;

const t = createTranslator(locale);
const { listing } = detail;
const basePath = locale === "en" ? "/en" : "";
const canonicalPath = `${basePath}/properties/${listing.id}`;

// 4.1 gallery: presign the hero-ordered photo thumbs; drop any that fail to sign (degrade, never 500).
// The hero (first) feeds og:image + the JSON-LD image so shared links preview the listing's photo.
const galleryUrls = (await presignThumbs(detail.photos.map((p) => p.thumbKey))).filter(
  (u): u is string => u !== null,
);
const heroUrl = galleryUrls[0];

// TH-03 ruling (logged): land units stay Thai on both locales — they are the market's units.
const landParts: string[] = [];
if (listing.landRai) landParts.push(`${listing.landRai} ไร่`);
if (listing.landNgan) landParts.push(`${listing.landNgan} งาน`);
if (listing.landWah) landParts.push(`${listing.landWah} ตร.ว.`);

// COPY-04: restricted-transfer deed types carry their warning right in the deed row.
const deedValue = NO_SALE_DEED_TYPES.has(listing.titleDeedType)
  ? `${t(`deed.${listing.titleDeedType}`)} — ${t("deed.restricted")}`
  : t(`deed.${listing.titleDeedType}`);

// F-10 road frontage: combine the access type and the width (เมตร) into one row; either may be absent.
const roadParts: string[] = [];
if (listing.roadType !== null) roadParts.push(t(`road.${listing.roadType}`));
if (listing.roadAccessM !== null) roadParts.push(t("field.roadWidth", { m: listing.roadAccessM }));
const roadValue = roadParts.length > 0 ? roadParts.join(" · ") : null;

const fieldRows = [
  { label: t("filter.propertyType"), value: t(`ptype.${listing.propertyType}`) },
  // COMP-06 new-vs-resale: a first-class buyer signal, shown as subtle meta (omit when unstated).
  ...(listing.saleCondition !== "unknown"
    ? [{ label: t("filter.newVsResale"), value: t(`condition.${listing.saleCondition}`) }]
    : []),
  { label: t("listing.deedSection"), value: deedValue },
  ...(landParts.length > 0 ? [{ label: t("listing.landArea"), value: landParts.join(" ") }] : []),
  ...(listing.floorAreaSqm !== null
    ? [{ label: t("listing.floorArea"), value: `${listing.floorAreaSqm} ตร.ม.` }]
    : []),
  // FIELD-07: seller-disclosed flood history — shown whenever disclosed, never re-judged.
  ...(listing.floodHistory !== null
    ? [{ label: t("field.flood"), value: t(listing.floodHistory ? "field.floodYes" : "field.floodNo") }]
    : []),
  ...(listing.tenure !== null
    ? [
        {
          label: t("field.tenure"),
          value:
            listing.leaseYears !== null
              ? `${listing.tenure} (${t("field.leaseYears", { count: listing.leaseYears })})`
              : listing.tenure,
        },
      ]
    : []),
  ...(listing.projectName !== null
    ? [{ label: t("field.project"), value: listing.projectName }]
    : []),
  // 4.8 plot/orientation fields — secondary "subtle meta" rows, omitted when absent.
  // FIELD-11: seller-asserted facing is shown as-is, never re-judged.
  ...(listing.facingDirection !== null
    ? [{ label: t("field.facing"), value: t(`facing.${listing.facingDirection}`) }]
    : []),
  // F-10: road frontage = width (m) and/or access type; road_type=none carries its own warning copy.
  ...(roadValue !== null ? [{ label: t("field.road"), value: roadValue }] : []),
  // F-11: city-plan colour zone (free-text, e.g. "เหลือง"/"yellow") — shown verbatim.
  ...(listing.cityPlanZoneColor !== null && listing.cityPlanZoneColor !== ""
    ? [{ label: t("field.zone"), value: listing.cityPlanZoneColor }]
    : []),
];

// Condo detail group (FIELD-04/05): fees + foreign-quota, omit-when-absent. Floor/building/unit are
// a 4.7 schema gap (no column on listing_condo) — not rendered here.
const condo = detail.condo;
// FIELD-05 foreign quota: the project % and the availability flag are one concept — render a single
// row, joining whichever are present ("49% ของโครงการ · มีโควตาต่างชาติว่าง").
const foreignQuotaParts: string[] = [];
if (condo?.projectForeignQuotaPct != null) {
  foreignQuotaParts.push(t("field.foreignQuotaPct", { pct: condo.projectForeignQuotaPct }));
}
if (condo?.foreignQuotaAvailable != null) {
  foreignQuotaParts.push(
    t(condo.foreignQuotaAvailable ? "field.foreignQuotaAvailable" : "field.foreignQuotaFull"),
  );
}
const condoRows = condo
  ? [
      ...(condo.camFeePerSqmMonth !== null
        ? [{ label: t("field.camFee"), value: t("field.camFeeValue", { thb: condo.camFeePerSqmMonth }) }]
        : []),
      ...(condo.sinkingFundPerSqm !== null
        ? [
            {
              label: t("field.sinkingFund"),
              value: t("field.sinkingFundValue", { thb: condo.sinkingFundPerSqm }),
            },
          ]
        : []),
      ...(foreignQuotaParts.length > 0
        ? [{ label: t("field.foreignQuota"), value: foreignQuotaParts.join(" · ") }]
        : []),
      ...(condo.quotaBucket !== null
        ? [{ label: t("field.quotaBucket"), value: t(`quota.${condo.quotaBucket}`) }]
        : []),
    ]
  : [];

// Rental lease-terms group (DEAL-11/FIELD-08/12), shown only for rentals. The monthly rent itself is
// framed by PriceDisplay (MKT-03 "ค่าเช่า/เดือน"); this is the rest of the lease. utility=unknown is a
// non-answer → omitted, like the other null rows.
const rental = listing.dealType === "rent" ? detail.rental : null;
// FIELD-12 furnishing: the status enum and the free-text notes are one concept — one row, joined.
const furnishingParts: string[] = [];
if (rental?.furnishingStatus != null) furnishingParts.push(t(`furnishing.${rental.furnishingStatus}`));
if (rental?.furnishingNotes != null && rental.furnishingNotes !== "") {
  furnishingParts.push(rental.furnishingNotes);
}
const rentalRows = rental
  ? [
      ...(rental.depositMonths !== null
        ? [{ label: t("field.deposit"), value: t("field.monthsValue", { count: rental.depositMonths }) }]
        : []),
      ...(rental.advanceMonths !== null
        ? [{ label: t("field.advance"), value: t("field.monthsValue", { count: rental.advanceMonths }) }]
        : []),
      ...(rental.minLeaseMonths !== null
        ? [{ label: t("field.minLease"), value: t("field.monthsValue", { count: rental.minLeaseMonths }) }]
        : []),
      ...(furnishingParts.length > 0
        ? [{ label: t("field.furnishing"), value: furnishingParts.join(" — ") }]
        : []),
      ...(rental.petsAllowed !== null
        ? [{ label: t("field.pets"), value: t(rental.petsAllowed ? "field.petsYes" : "field.petsNo") }]
        : []),
      ...(rental.utilityRateType !== null && rental.utilityRateType !== "unknown"
        ? [{ label: t("field.utilities"), value: t(`utility.${rental.utilityRateType}`) }]
        : []),
    ]
  : [];

// DIST-01/02/P8 provenance disclosure (NPA / LED auction). Delivered CALMLY — a category note in
// muted text, with the DIST-02 caveats as visible (non-collapsed) lines for auctions — NOT a red
// alert banner (founder tone direction). `normal` listings get nothing. The calm NPA category badge
// itself rides on StatusBadge above; this is the honest contextual text the register's P8 requires.
const provenanceNote =
  listing.listingType === "npa"
    ? t("provenance.npa")
    : listing.listingType === "auction"
      ? t("provenance.auction")
      : null;
// DIST-02: LED auction listings carry three mandatory caveats (as-is / may be occupied / verify title).
const auctionCaveats =
  listing.listingType === "auction"
    ? [
        t("provenance.auctionAsIs"),
        t("provenance.auctionOccupied"),
        t("provenance.auctionVerifyTitle"),
      ]
    : [];

const locationLine = [listing.landmark, listing.tambon, listing.amphoe, listing.province]
  .filter((p): p is string => p !== null && p !== "")
  .join(" · ");

// CONV-06: the LINE chat CTA is wired when the founder configures the OA link
// (Pulumi config → LINE_OA_URL env). Phone is never shown — not public data here.
const lineOaUrl = import.meta.env.LINE_OA_URL ?? process.env.LINE_OA_URL ?? "";

const jsonLd = safeJsonLdScript(
  listingJsonLd(detail, new URL(canonicalPath, Astro.site).href, galleryUrls),
);
---

<Base
  title={detail.headline}
  description={locationLine}
  canonicalPath={canonicalPath}
  ogImage={heroUrl}
>
  <script is:inline type="application/ld+json" set:html={jsonLd} slot="head" />
  {/* data-th-content: the TH-07 line-height invariant (assertThaiBodyLineHeight) scans Thai body text
      here too, not just listing cards — closes the detail-page coverage gap. */}
  <main class="mx-auto grid max-w-3xl gap-4 px-4 py-4" data-th-content>

    <a href={`${basePath}/`} class="font-semibold text-primary-600 text-sm leading-relaxed">
      ← {t("home.title")}
    </a>
    {
      galleryUrls.length > 0 && (
        // CONV-04 photo-first: the hero leads the page. CONV-03: a thumbnail STRIP with a count, never
        // dots-only. Zero client JS (TECH-01/02) — a scrollable strip; the hero is the first photo.
        <section aria-label={t("listing.photos", { count: galleryUrls.length })} class="grid gap-2">
          <div class="relative aspect-[4/3] overflow-hidden rounded-md bg-surface-2">
            <img src={heroUrl} alt={detail.headline} class="h-full w-full object-cover" />
            <span class="absolute right-2 bottom-2 inline-flex items-center rounded-sm bg-black/75 px-2 py-px font-latin text-white text-xs">
              {t("listing.photos", { count: detail.photoCount })}
            </span>
          </div>
          {galleryUrls.length > 1 && (
            <div class="flex gap-1 overflow-x-auto">
              {galleryUrls.map((url, i) => (
                <img
                  src={url}
                  alt={`${detail.headline} — ${i + 1}`}
                  loading="lazy"
                  class="h-[60px] flex-[0_0_80px] rounded-sm border border-border bg-surface-2 object-cover"
                />
              ))}
            </div>
          )}
        </section>
      )
    }
    <h1 class="m-0 font-bold font-heading-th text-2xl text-text leading-normal" lang={locale}>
      {detail.headline}
    </h1>
    <StatusBadge listing={listing} t={t} />
    {/* DIST-01/02/P8: calm provenance disclosure for NPA / LED auction stock. A muted surface card
        (NOT a danger banner — founder tone direction), but the DIST-02 caveats are visible text, not
        collapsed. `normal` listings render nothing (omit-when-absent). */}
    {provenanceNote !== null && (
      <section
        aria-label={t("provenance.heading")}
        class="grid gap-2 rounded-md border border-border bg-surface-2 p-3"
      >
        <strong class="text-sm text-text leading-relaxed" lang={locale}>
          {t("provenance.heading")}
        </strong>
        <p class="m-0 text-sm text-text-2 leading-relaxed" lang={locale}>
          {provenanceNote}
        </p>
        {auctionCaveats.length > 0 && (
          <ul class="m-0 grid gap-1 ps-5 text-sm text-text-2 leading-relaxed">
            {auctionCaveats.map((c) => (
              <li lang={locale}>{c}</li>
            ))}
          </ul>
        )}
      </section>
    )}
    {/* Direction-a tinted price block — the hero price sits in a primary-tinted card. */}
    <div class="rounded-md border border-primary-100 bg-primary-50 px-4 py-3">
      <PriceDisplay listing={listing} monthlyRent={detail.monthlyRent} size="detail" t={t} />
    </div>
    {/* TH-08: place names are verbatim Thai on both locales (like land units, TH-03) — tag the
        container lang="th" so an /en/ page (html lang="en") still gets Thai line-breaking, not break-all. */}
    <p lang="th" class="m-0 text-sm text-text-2 leading-relaxed">📍 {locationLine}</p>
    {listing.bedrooms !== null && listing.bathrooms !== null && (
      <p class="m-0 text-base text-text leading-relaxed">
        {t("listing.bedrooms", { count: listing.bedrooms })} ·{" "}
        {t("listing.bathrooms", { count: listing.bathrooms })}
      </p>
    )}
    {lineOaUrl !== "" && <LineCtaButton lineHref={lineOaUrl} t={t} />}
    {/* No renderable gallery yet (thumbs not derived) but photos exist: surface the count so the
        listing doesn't look photo-less. When the gallery renders, it already shows the count. */}
    {galleryUrls.length === 0 && detail.photoCount > 0 && (
      <Badge kind="available">{t("listing.photos", { count: detail.photoCount })}</Badge>
    )}
    <FieldList rows={fieldRows} />
    {/* 4.8 rental lease terms (MKT-03 monthly framing is on the price above) — its own labeled
        group for rentals. Collapsed: the rent is above the fold; the lease terms are secondary
        "subtle meta" (founder direction), so they sit in a closed accordion (P7/CONV-05). */}
    {rentalRows.length > 0 && (
      <AccordionSection title={t("detail.rentalSection")}>
        <FieldList rows={rentalRows} />
      </AccordionSection>
    )}
    {/* 4.8 condo-specific group (fees + foreign quota, FIELD-04/05). */}
    {condoRows.length > 0 && (
      <AccordionSection title={t("detail.condoSection")}>
        <FieldList rows={condoRows} />
      </AccordionSection>
    )}
    {detail.description !== "" && (
      <AccordionSection title={t("detail.description")} defaultOpen>
        <p lang={locale} class="m-0 whitespace-pre-wrap text-sm text-text-2 leading-relaxed">{detail.description}</p>
      </AccordionSection>
    )}
    {detail.posterName !== "" && (
      <p class="m-0 text-sm text-text-2 leading-relaxed">
        {t("listing.postedBy", { name: detail.posterName })} ·{" "}
        {/* data-testid lets the visual-regression suite mask this per-run date (plan 20). */}
        <span data-testid="listing-updated">
          {t("listing.updated", { date: listing.updatedAt.toISOString().slice(0, 10) })}
        </span>
      </p>
    )}
    <p class="m-0 text-sm text-text-2 leading-relaxed">
      {t("legal.posterProvided")}
    </p>
    {/* LEGAL-07: non-dismissible foreign-ownership disclaimer (always shown, not a
        closeable banner). The per-listing foreign-quota figures (FIELD-05) render in the
        condo group above when present; this legal notice is the always-on backstop. */}
    <p class="m-0 text-sm text-text-2 leading-relaxed">
      {t("legal.foreignOwnership")}
    </p>
  </main>
</Base>
